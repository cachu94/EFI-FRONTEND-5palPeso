                <mxCell id="comp_metricas_ui" parent="sec_components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8B4FE;fontColor=#581C87;fontSize=11;align=left;spacingLeft=10;" value="&lt;b&gt;Componentes Especializados de Métricas&lt;/b&gt;&lt;br&gt;• &lt;code&gt;FondosComprometidosCard&lt;/code&gt; (monto por cuenta sugerido)&lt;br&gt;• &lt;code&gt;CreditSimulationTable&lt;/code&gt; (proyección mes a mes)&lt;br&gt;• &lt;code&gt;DtiThermometer&lt;/code&gt; (índice de endeudamiento DTI colorimétrico)&lt;br&gt;• &lt;code&gt;DailyBudgetBanner&lt;/code&gt; (presupuesto diario remanente)" vertex="1">
